---
// Home page: hero, value snapshot, featured projects, closing CTA.

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const featured = projects.filter((project) => project.featured);
---

<BaseLayout
  title="Home"
  description="Jordan Avery — a developer who turns fuzzy ideas into clear, dependable software."
>
  <!-- ============================= Hero ============================= -->
  <section class="relative overflow-hidden">
    <!-- Decorative background: faded grid + soft accent glows -->
    <div class="pointer-events-none absolute inset-0 bg-grid" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-teal/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-orange/10 blur-3xl" aria-hidden="true"></div>

    <!-- Subtle geometric ring (desktop only) -->
    <svg
      class="pointer-events-none absolute right-10 top-1/2 hidden w-64 -translate-y-1/2 text-orange/40 lg:block"
      viewBox="0 0 200 200"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="100" cy="100" r="78" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 8" opacity="0.7" />
      <circle cx="100" cy="100" r="56" stroke="currentColor" stroke-width="1.5" opacity="0.45" />
      <path d="M22 100h156" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
    </svg>

    <div class="relative mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:py-32">
      <p data-reveal class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-teal">
        Hey, I'm Jordan Avery
      </p>

      <h1 data-reveal class="max-w-3xl font-display text-5xl font-bold leading-[1.05] tracking-tight text-ink sm:text-6xl lg:text-7xl">
        Clean software,<br class="hidden sm:block" /> built to <span class="text-orange">last</span>.
      </h1>

      <p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-ink/70">
        I'm a developer who turns fuzzy ideas into clear, dependable products —
        design-minded, type-safe, and a little retro in taste.
      </p>

      <div data-reveal class="mt-9 flex flex-wrap gap-3">
        <a class="btn btn--primary" href="/projects">View Projects</a>
        <a class="btn btn--secondary" href="/about">About Me</a>
      </div>
    </div>
  </section>

  <!-- ======================= Value snapshot ======================== -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6">
    <div data-reveal class="grid gap-8 border-y border-ink/10 py-10 sm:grid-cols-3 sm:gap-6">
      <div class="flex gap-4">
        <svg viewBox="0 0 24 24" class="mt-1 h-6 w-6 shrink-0 text-teal" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m8.5 6.5-5.5 5.5 5.5 5.5M15.5 6.5l5.5 5.5-5.5 5.5" />
        </svg>
        <div>
          <h2 class="font-display text-base font-bold text-ink">Clear code</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink/70">
            Typed, readable, and easy to pick back up months later.
          </p>
        </div>
      </div>

      <div class="flex gap-4">
        <svg viewBox="0 0 24 24" class="mt-1 h-6 w-6 shrink-0 text-teal" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 5.5l5 14 2.7-6.3 6.3-2.7-14-5Z" />
        </svg>
        <div>
          <h2 class="font-display text-base font-bold text-ink">User-first</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink/70">
            Fast, focused interfaces that respect people's attention.
          </p>
        </div>
      </div>

      <div class="flex gap-4">
        <svg viewBox="0 0 24 24" class="mt-1 h-6 w-6 shrink-0 text-orange" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 12h5l3-7 4.5 14 3-7h3.5" />
        </svg>
        <div>
          <h2 class="font-display text-base font-bold text-ink">Steady shipping</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink/70">
            Small releases, quick feedback, constant improvement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Featured projects ======================= -->
  <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
    <div data-reveal class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          Featured projects
        </h2>
      </div>
      <a class="link-arrow" href="/projects">
        See all projects
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 12.5 12.5 3.5M5.5 3.5h7v7" />
        </svg>
      </a>
    </div>

    <div data-reveal class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((project) => (
          <ProjectCard project={project} />
        ))
      }
    </div>
  </section>

  <!-- ========================= Closing CTA ========================= -->
  <section class="mx-auto max-w-5xl px-4 pb-24 sm:px-6">
    <div data-reveal class="relative overflow-hidden rounded-3xl border border-ink/10 px-6 py-14 text-center sm:px-12">
      <div class="pointer-events-none absolute inset-0 bg-grid" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full bg-teal/10 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-20 -right-20 h-64 w-64 rounded-full bg-orange/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative">
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          Like what you see?
        </h2>
        <p class="mx-auto mt-3 max-w-md text-ink/70">
          There's more in the archive — or find out how I approach a project
          from idea to launch.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="btn btn--primary" href="/projects">View Projects</a>
          <a class="btn btn--secondary" href="/about">More About Me</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>