---
// A single project card, used on both the Home teaser and the Projects page.
// The graphic is a geometric placeholder (a faded vaporwave-style grid with a
// concentric-sun motif); swap it for a real image or screenshot later.

import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// The placeholder graphic leans teal or orange depending on the project tone.
const isTeal = project.tone === 'teal';
const accent = isTeal ? '#14B8A6' : '#F97316';
const subtle = isTeal ? 'from-teal/15 via-paper to-orange/5' : 'from-orange/15 via-paper to-teal/5';
---

<article class="card">
  <!-- Placeholder graphic -->
  <div class={`relative overflow-hidden border-b border-ink/10 bg-gradient-to-br ${subtle}`}>
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>

    <svg
      viewBox="0 0 96 96"
      class="relative m-auto h-36 w-36 py-4 sm:h-44 sm:w-44"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="48" cy="50" r="30" stroke={accent} stroke-width="2" opacity="0.65" />
      <circle cx="48" cy="50" r="19" stroke={accent} stroke-width="2" opacity="0.45" />
      <circle cx="48" cy="50" r="8" fill={accent} opacity="0.7" />
      <path d="M16 50h64" stroke={accent} stroke-width="1.5" opacity="0.3" />
    </svg>
  </div>

  <div class="flex flex-1 flex-col gap-4 p-6">
    <h3 class="font-display text-xl font-bold tracking-tight text-ink">{project.title}</h3>

    <p class="text-sm leading-relaxed text-ink/70">{project.description}</p>

    <ul class="flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <li>
            <span class="tag">{tag}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-auto flex items-center gap-5 pt-1">
      <a class="link-arrow" href={project.liveUrl}>
        Live demo
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 12.5 12.5 3.5M5.5 3.5h7v7" />
        </svg>
      </a>
      <a
        class="text-sm font-semibold text-ink/60 underline-offset-4 transition-colors duration-200 hover:text-orange hover:underline"
        href={project.codeUrl}
      >
        Code
      </a>
    </div>
  </div>
</article>