{
  "name": "dnstest-site",
  "version": "1.0.0",
  "private": true,
  "description": "Companion landing page for the dnstest CLI (pure-black terminal aesthetic).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build": "npm run build:css && node ./scripts/copy-static.mjs",
    "watch": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "serve": "python -m http.server 4322 --directory dist"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}