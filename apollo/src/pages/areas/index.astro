---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { allAreas } from '../../data/areas';
import CtaBand from '../../components/CtaBand.astro';

const title = 'Service Areas | Apollo Professional — Evanston, IL & Beyond';
const description =
  'Apollo Professional proudly serves Evanston, IL and nearby communities within a 30-mile radius of Chicago — window cleaning, gutters, screens, and power washing. Call (773) 600-1308.';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: `${site.url}/areas/`,
  telephone: '+1-773-600-1308',
  address: { '@type': 'PostalAddress', addressLocality: 'Evanston', addressRegion: 'IL', addressCountry: 'US' },
  areaServed: allAreas.map((a) => a.name),
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-navy-deep via-navy to-navy-mid">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-wider text-brand-bright">Service Areas</p>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Proudly Serving Evanston, IL, and Beyond
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">
        We proudly serve Evanston, IL, and nearby communities with reliable cleaning solutions — {site.radius}. No
        matter your location, our team delivers detailed, dependable service you can trust.
      </p>
    </div>
  </section>

  <!-- Area grid -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {allAreas.map((area, i) => (
          <div class="reveal" style={`transition-delay: ${(i % 4) * 50}ms`}>
            {area.slug ? (
              <a
                href={`/areas/${area.slug}/`}
                class="card-lift flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-soft"
              >
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-navy-soft text-brand">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6z" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                </span>
                <h2 class="mt-4 font-display text-lg font-bold text-navy">{area.name}</h2>
                <p class="mt-1.5 flex-1 text-sm text-slate-500">
                  {area.name.split(',')[0]} cleaning services — windows, gutters, screens, and more.
                </p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand">
                  View services
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M4 10h12m0 0l-4-4m4 4l-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            ) : (
              <div class="flex h-full flex-col rounded-2xl border border-slate-200 bg-navy-faint p-6">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-slate-400">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6z" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                </span>
                <h2 class="mt-4 font-display text-lg font-bold text-navy">{area.name}</h2>
                <p class="mt-1.5 flex-1 text-sm text-slate-500">
                  Available for all services — call us to schedule.
                </p>
                <a href={site.phoneHref} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand">
                  Call {site.phone}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
