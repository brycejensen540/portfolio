---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { allAreas } from '../../data/areas';
import { images } from '../../data/images';
import CtaBand from '../../components/CtaBand.astro';
import MediaImage from '../../components/MediaImage.astro';

const title = 'Service Areas | Apollo Professional — Chicago, IL & Beyond';
const description =
  'Apollo Professional proudly serves Chicago, IL and nearby communities within a 30-mile radius — window cleaning, gutters, screens, and power washing. Call (773) 600-1308.';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: `${site.url}/areas/`,
  telephone: '+1-773-600-1308',
  address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  areaServed: allAreas.map((a) => a.name),
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-surface">
    <div
      class="pointer-events-none absolute -right-40 -top-40 h-[26rem] w-[26rem] rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(74, 143, 168, 0.2), transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-24 sm:px-6 lg:px-8 lg:pb-28 lg:pt-32">
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
        <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
        Service Areas
      </p>
      <h1 class="mt-6 max-w-3xl font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
        Proudly Serving Chicago, IL, and Beyond
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft">
        We proudly serve Chicago, IL, and nearby communities with reliable cleaning solutions — {site.radius}. No
        matter your location, our team delivers detailed, dependable service you can trust.
      </p>
    </div>
  </section>

  <!-- Feature photo -->
  <section class="bg-white pb-24 pt-4 lg:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal">
        <MediaImage image={images.areas.chicago} label="Chicago skyline and lakefront" class="aspect-[21/9] shadow-soft" />
      </div>
    </div>
  </section>

  <!-- Area grid -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {allAreas.map((area, i) => (
          <div class="reveal" style={`transition-delay: ${(i % 4) * 50}ms`}>
            {area.slug ? (
              <a
                href={`/areas/${area.slug}/`}
                class="card-lift flex h-full flex-col rounded-2xl bg-white p-8 shadow-soft ring-1 ring-ink/5"
              >
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-light text-accent">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6z" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </span>
                <h2 class="mt-5 font-display text-xl font-semibold text-ink">{area.name}</h2>
                <p class="mt-2 flex-1 text-sm text-ink-faint">
                  {area.name.split(',')[0]} cleaning services — windows, gutters, screens, and more.
                </p>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                  View services
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M4 10h12m0 0l-4-4m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            ) : (
              <div class="flex h-full flex-col rounded-2xl bg-surface-alt p-8 ring-1 ring-ink/8">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-ink-faint">
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6z" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </span>
                <h2 class="mt-5 font-display text-xl font-semibold text-ink">{area.name}</h2>
                <p class="mt-2 flex-1 text-sm text-ink-faint">
                  Available for all services — call us to schedule.
                </p>
                <a href={site.phoneHref} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                  Call {site.phone}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
