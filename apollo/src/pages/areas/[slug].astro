---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { areaPages, type AreaPage } from '../../data/areas';
import CtaBand from '../../components/CtaBand.astro';
import MediaImage from '../../components/MediaImage.astro';

export function getStaticPaths() {
  return areaPages.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: AreaPage;
}

const { area } = Astro.props;
const others = areaPages.filter((a) => a.slug !== area.slug);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: `${site.url}/areas/${area.slug}/`,
  telephone: '+1-773-600-1308',
  address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  areaServed: area.name,
});
---

<BaseLayout title={`${area.name} Cleaning Services | Apollo Professional`} description={area.metaDescription} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-surface">
    <div
      class="pointer-events-none absolute -right-40 -top-40 h-[26rem] w-[26rem] rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(74, 143, 168, 0.2), transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-24 sm:px-6 lg:px-8 lg:pb-28 lg:pt-32">
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
        <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
        {area.eyebrow}
      </p>
      <h1 class="mt-6 max-w-3xl font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
        {area.title}
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft">{area.intro}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/#quote" class="btn-primary px-8 py-4 text-base">Get a Free Quote</a>
        <a href={site.phoneHref} class="btn-outline px-8 py-4 text-base">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3.5 4.5c0-1.1.9-2 2-2h2l1.5 4-2 1.5a11 11 0 005 5l1.5-2 4 1.5v2c0 1.1-.9 2-2 2A12.5 12.5 0 013.5 4.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          </svg>
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Body -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mb-16 grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <MediaImage image={area.image} label={area.name} class="aspect-[16/10] shadow-soft" />
        <div class="flex flex-col justify-center rounded-2xl bg-surface-alt p-10 ring-1 ring-ink/8">
          <h2 class="font-display text-2xl font-semibold text-ink">Serving {area.name}</h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft">
            All Apollo Professional services are available in {area.name} — window cleaning, gutter cleaning, screen
            cleaning and repair, and power washing.
          </p>
          <a href="/contact/#quote" class="btn-primary mt-8 self-start px-7 py-3.5 text-sm">Request Your Cleaning Quote</a>
        </div>
      </div>

      <div class="grid gap-16 lg:grid-cols-2">
        <div class="reveal space-y-6">
          {area.body.map((paragraph) => (
            <p class="text-lg leading-relaxed text-ink-soft">{paragraph}</p>
          ))}
        </div>

        <div class="space-y-12">
          {area.services && (
            <div class="reveal">
              <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">Our Services in {area.name}</h2>
              <div class="mt-8 space-y-5">
                {area.services.map((service) => (
                  <div class="rounded-xl bg-white p-7 shadow-soft ring-1 ring-ink/5">
                    <h3 class="font-display text-lg font-semibold text-ink">{service.title}</h3>
                    <p class="mt-3 text-sm leading-relaxed text-ink-soft">{service.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {area.tips && (
            <div class="reveal">
              <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">Helpful Tips for a Cleaner Home</h2>
              <div class="mt-8 space-y-5">
                {area.tips.map((tip) => (
                  <div class="flex items-start gap-4 rounded-xl bg-surface-alt p-6 ring-1 ring-ink/8">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div>
                      <h3 class="text-sm font-bold text-ink">{tip.title}</h3>
                      <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{tip.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Other areas -->
  <section class="border-t border-ink/8 bg-surface-alt py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">Other Service Areas</h2>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/areas/" class="rounded-xl border border-ink/15 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-soft transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent-deep">
          All Service Areas
        </a>
        {others.map((other) => (
          <a
            href={`/areas/${other.slug}/`}
            class="rounded-xl border border-ink/15 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-soft transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent-deep"
          >
            {other.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
