---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { areaPages, type AreaPage } from '../../data/areas';
import CtaBand from '../../components/CtaBand.astro';
import MediaImage from '../../components/MediaImage.astro';

export function getStaticPaths() {
  return areaPages.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: AreaPage;
}

const { area } = Astro.props;
const others = areaPages.filter((a) => a.slug !== area.slug);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: `${site.url}/areas/${area.slug}/`,
  telephone: '+1-773-600-1308',
  address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  areaServed: area.name,
});
---

<BaseLayout title={`${area.name} Cleaning Services | Apollo Professional`} description={area.metaDescription} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-navy-deep via-navy to-navy-mid">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-wider text-brand-bright">{area.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        {area.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">{area.intro}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/#quote" class="btn-primary px-7 py-3.5 text-base">Get a Free Quote</a>
        <a href={site.phoneHref} class="btn-outline-light px-7 py-3.5 text-base">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3.5 4.5c0-1.1.9-2 2-2h2l1.5 4-2 1.5a11 11 0 005 5l1.5-2 4 1.5v2c0 1.1-.9 2-2 2A12.5 12.5 0 013.5 4.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Body -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mb-12 grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <MediaImage topic="map" image={area.image} label={area.name} class="aspect-[16/10]" />
        <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-navy-faint p-8 shadow-soft">
          <h2 class="font-display text-xl font-bold text-navy">Serving {area.name}</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            All Apollo Professional services are available in {area.name} — window cleaning, gutter cleaning, screen
            cleaning and repair, and power washing.
          </p>
          <a href="/contact/#quote" class="btn-primary mt-6 self-start px-6 py-3 text-sm">Request Your Cleaning Quote</a>
        </div>
      </div>

      <div class="grid gap-12 lg:grid-cols-2">
        <div class="reveal space-y-5">
          {area.body.map((paragraph) => (
            <p class="leading-relaxed text-slate-600">{paragraph}</p>
          ))}
        </div>

        <div class="space-y-10">
          {area.services && (
            <div class="reveal">
              <h2 class="font-display text-2xl font-bold text-navy">Our Services in {area.name}</h2>
              <div class="mt-6 space-y-4">
                {area.services.map((service) => (
                  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-soft">
                    <h3 class="font-display text-base font-bold text-navy">{service.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {area.tips && (
            <div class="reveal">
              <h2 class="font-display text-2xl font-bold text-navy">Helpful Tips for a Cleaner Home</h2>
              <div class="mt-6 space-y-4">
                {area.tips.map((tip) => (
                  <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-navy-faint p-5">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div>
                      <h3 class="text-sm font-bold text-navy">{tip.title}</h3>
                      <p class="mt-1 text-sm leading-relaxed text-slate-600">{tip.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Other areas -->
  <section class="border-t border-slate-200 bg-navy-faint py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-navy">Other Service Areas</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/areas/" class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-navy shadow-soft transition-all hover:-translate-y-0.5 hover:border-brand hover:text-brand-deep">
          All Service Areas
        </a>
        {others.map((other) => (
          <a
            href={`/areas/${other.slug}/`}
            class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-navy shadow-soft transition-all hover:-translate-y-0.5 hover:border-brand hover:text-brand-deep"
          >
            {other.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
