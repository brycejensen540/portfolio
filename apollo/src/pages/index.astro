---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { allAreas } from '../data/areas';
import { reviews } from '../data/reviews';
import { images } from '../data/images';
import ServiceCard from '../components/ServiceCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CtaBand from '../components/CtaBand.astro';
import MediaImage from '../components/MediaImage.astro';
import Sparkles from '../components/Sparkles.astro';
import Bubbles from '../components/Bubbles.astro';

const title = 'Apollo Professional | Window & Exterior Cleaning in Chicago, IL';
const description =
  'We don’t just clean windows so they look clean — we clean them so they are clean. Detail-focused window cleaning, gutters, screens, and pressure washing in Chicago, IL and the surrounding suburbs. Call (773) 600-1308.';

const homeReviews = reviews.slice(0, 6);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: '+1-773-600-1308',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Chicago',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
  areaServed: 'Greater Chicago area, IL',
  founder: { '@type': 'Person', name: 'Eric' },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '22:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '10:00',
      closes: '22:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.score,
    reviewCount: '33',
  },
  priceRange: '$$',
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- ============ Hero ============ -->
  <section class="relative overflow-hidden bg-surface">
    <div
      class="pointer-events-none absolute -right-48 -top-48 h-[36rem] w-[36rem] rounded-full opacity-30 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(74, 143, 168, 0.2), transparent 70%);"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -bottom-56 -left-40 h-[30rem] w-[30rem] rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(74, 143, 168, 0.15), transparent 70%);"
      aria-hidden="true"
    ></div>

    <Bubbles />
    <Sparkles />

    <div class="relative mx-auto grid max-w-7xl items-center gap-16 px-4 pb-24 pt-20 sm:px-6 lg:grid-cols-[minmax(0,11fr)_minmax(0,10fr)] lg:gap-20 lg:px-8 lg:pb-32 lg:pt-28">
      <div>
        <p class="mb-7 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
          Chicago, IL · Serving the surrounding suburbs
        </p>
        <h1 class="font-display text-5xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl lg:text-[4.25rem]">
          Detail-Focused<br />
          <span class="italic text-accent">Every Single Time</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-soft">
          We provide top-quality cleaning solutions that keep your property looking its best — completed thoroughly,
          on time, and with unmatched attention to detail. {site.tagline}
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/#quote" class="btn-primary px-8 py-4 text-base">Get a Free Quote</a>
          <a href={site.phoneHref} class="btn-outline px-8 py-4 text-base">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3.5 4.5c0-1.1.9-2 2-2h2l1.5 4-2 1.5a11 11 0 005 5l1.5-2 4 1.5v2c0 1.1-.9 2-2 2A12.5 12.5 0 013.5 4.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
            Call {site.phone}
          </a>
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-10 gap-y-4">
          <span class="flex items-center gap-2.5 text-sm text-ink-soft">
            <span class="flex text-accent" aria-label="Rated 5 out of 5 stars">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
            </span>
            <strong class="text-ink">{site.rating.score}/5.00</strong> · {site.rating.label}
          </span>
          <span class="hidden h-8 w-px bg-ink/10 sm:block" aria-hidden="true"></span>
          <span class="text-sm text-ink-soft">Serving {site.radius}</span>
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-ink/8 pt-8">
          <p class="text-xs font-semibold uppercase tracking-widest text-ink-faint">Trusted &amp; reviewed on</p>
          <img src="/badges/Angi-175x100-Color.svg" alt="Angi" class="h-7 w-auto opacity-50" loading="lazy" />
          <img src="/badges/Home-Advisor-Screened-and-Approved-175x100-Color.svg" alt="Home Advisor — Screened and Approved" class="h-7 w-auto opacity-50" loading="lazy" />
          <img src="/badges/Home-Advisor-Top-Rated-175x100-Color.svg" alt="Home Advisor — Top Rated" class="h-7 w-auto opacity-50" loading="lazy" />
          <img src="/badges/Yelp-New-Logo-175x100-Color.svg" alt="Yelp" class="h-7 w-auto opacity-50" loading="lazy" />
        </div>
      </div>

      <!-- Hero photo -->
      <div class="reveal relative">
        <div class="absolute -right-4 -top-4 hidden h-full w-full rounded-2xl border border-accent/20 lg:block" aria-hidden="true"></div>
        <MediaImage image={images.hero} label="Window cleaning in natural light" class="aspect-[4/5] shadow-soft" />
        <p class="mt-5 text-center text-xs font-semibold uppercase tracking-widest text-ink-faint">
          The detail behind the shine
        </p>
      </div>
    </div>
  </section>

  <!-- ============ Services ============ -->
  <section class="bg-white py-24 lg:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-end">
        <div>
          <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
            <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
            What We Do
          </p>
          <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
            Professional Cleaning Services for Every Surface
          </h2>
        </div>
        <p class="max-w-md text-base leading-relaxed text-ink-soft lg:pb-2">
          From sparkling windows to clear gutters, we handle the details so your property looks its absolute best.
        </p>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => (
          <div class="reveal" style={`transition-delay: ${(i % 3) * 60}ms`}>
            <ServiceCard service={service} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Philosophy ============ -->
  <section class="relative overflow-hidden bg-ink py-24 lg:py-36">
    <div
      class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full opacity-30 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(74, 143, 168, 0.25), transparent 70%);"
      aria-hidden="true"
    ></div>
    <Sparkles
      items={[
        { top: '18%', right: '12%', size: 7, delay: 0, tone: 'white' },
        { top: '42%', left: '48%', size: 5, delay: 2.1, tone: 'white' },
        { bottom: '20%', right: '24%', size: 6, delay: 3.4, tone: 'white' },
      ]}
    />
    <div class="relative mx-auto grid max-w-7xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-2 lg:gap-24 lg:px-8">
      <div class="reveal order-2 lg:order-1">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-accent/40" aria-hidden="true"></span>
          Our Philosophy
        </p>
        <blockquote class="mt-6 font-display text-3xl font-medium leading-snug text-white sm:text-4xl">
          “We don’t just clean windows so they look clean — we clean them so they <em class="italic text-accent">are</em> clean.”
        </blockquote>
        <p class="mt-7 max-w-xl leading-relaxed text-white/60">
          Apollo Professional prioritizes the quality, consistency, and meticulous attention to detail that most
          window cleaning companies overlook. We work directly with each client to deliver the exact level of clean
          they want — treating every window as more than just glass.
        </p>
        <p class="mt-4 max-w-xl leading-relaxed text-white/60">
          When desired, we go further — carefully removing paint, silicone, adhesive residue, and thoroughly cleaning
          tracks — restoring windows to a condition many homeowners haven’t seen in years.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="/about/" class="btn-outline-light px-7 py-3.5 text-sm">Know More About Us</a>
          <a href={site.phoneHref} class="btn-outline-light px-7 py-3.5 text-sm">Call Now</a>
        </div>
      </div>
      <div class="reveal order-1 lg:order-2">
        <MediaImage image={images.about.modern} label="Modern glass architecture in natural light" class="aspect-[4/5] shadow-soft" />
      </div>
    </div>
  </section>

  <!-- ============ Service areas ============ -->
  <section class="bg-surface py-24 lg:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="flex items-center justify-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
          Where We Work
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Proudly Serving the Greater Chicago Area
        </h2>
        <p class="mt-6 text-base leading-relaxed text-ink-soft">
          Based in Chicago, we serve homes and businesses {site.radius}.
        </p>
      </div>
      <div class="mt-16 grid items-center gap-16 lg:grid-cols-2 lg:gap-24">
        <div class="reveal">
          <MediaImage image={images.areas.chicago} label="Chicago skyline and lakefront" class="aspect-[4/3] shadow-soft" />
        </div>
        <div class="reveal">
          <ul class="grid grid-cols-1 gap-x-10 gap-y-4 sm:grid-cols-2">
            {allAreas.map((area) => (
              <li>
                {area.slug ? (
                  <a href={`/areas/${area.slug}/`} class="group flex items-center gap-3 text-sm font-semibold text-ink transition-colors hover:text-accent">
                    <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6z" stroke="currentColor" stroke-width="1.6" />
                      <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    {area.name}
                  </a>
                ) : (
                  <span class="flex items-center gap-3 text-sm font-medium text-ink-faint">
                    <svg class="h-4 w-4 shrink-0 text-ink-faint/50" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6z" stroke="currentColor" stroke-width="1.6" />
                      <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    {area.name}
                  </span>
                )}
              </li>
            ))}
          </ul>
          <a href="/areas/" class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors hover:text-accent-dark">
            See all service areas
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12m0 0l-4-4m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Testimonials ============ -->
  <section class="bg-white py-24 lg:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="flex items-center justify-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
          Testimonials
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          See Why Our Cleaning Services Shine
        </h2>
        <p class="mt-6 text-base text-ink-soft">
          Rated <strong class="text-ink">{site.rating.score}/5.0</strong> across {site.rating.count} Google reviews
        </p>
      </div>
      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {homeReviews.map((review, i) => (
          <div class="reveal" style={`transition-delay: ${(i % 3) * 60}ms`}>
            <ReviewCard review={review} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
