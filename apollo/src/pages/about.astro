---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import CtaBand from '../components/CtaBand.astro';
import MediaImage from '../components/MediaImage.astro';

const title = 'About Us | Apollo Professional — Chicago, IL';
const description =
  'Meet Apollo Professional — a detail-focused cleaning team in Chicago, IL serving the surrounding suburbs. Window cleaning, gutters, screens, power washing, and more. Call (773) 600-1308.';

const values = [
  {
    title: 'Detail-Focused',
    text: 'Customers appreciate our thorough work — especially in window corners. Every job gets our full attention, with high-quality results that last.',
  },
  {
    title: 'We Always Show Up',
    text: 'Reliability is our reputation. We arrive as scheduled, communicate clearly, and walk through the finished job with you before we leave.',
  },
  {
    title: 'Local Expertise',
    text: 'Based in Chicago and serving a 30-mile radius around the city, we know the weather, the homes, and the buildup local properties face.',
  },
  {
    title: 'Respect for Your Property',
    text: 'We protect your floors and furniture during interior work, rinse exterior surfaces thoroughly, and leave no mess behind.',
  },
];

const audiences = [
  { name: 'Homeowners', text: 'Single-family homes, condos, and townhomes across the North Shore and western suburbs.' },
  { name: 'HOAs & Property Managers', text: 'Dependable, repeatable exterior maintenance for common areas and individual units.' },
  { name: 'Real Estate Agents', text: 'Sparkling windows and spotless exteriors that help listings show their best.' },
  { name: 'Select Commercial', text: 'Storefronts, offices, and low-rise buildings that project a professional image.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Apollo Professional',
  url: `${site.url}/about/`,
  about: {
    '@type': 'LocalBusiness',
    name: site.name,
    telephone: '+1-773-600-1308',
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  },
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-navy-deep via-navy to-navy-mid">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-wider text-brand-bright">About Us</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Detail-Focused Cleaning Services in Chicago, IL, and Beyond
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">
        We provide premium cleaning services tailored to homeowners, HOAs, real estate agents, and select commercial
        clients. Our focus on detail and reliability sets us apart — filling the gap left by retiring window cleaners.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div class="reveal">
        <h2 class="font-display text-3xl font-bold tracking-tight text-navy sm:text-4xl">Who We Are</h2>
        <p class="mt-5 leading-relaxed text-slate-600">
          We don’t just clean windows so they look clean — we clean them so they <em>are</em> clean.
        </p>
        <p class="mt-4 leading-relaxed text-slate-600">
          Apollo Professional prioritizes the quality, consistency, and meticulous attention to detail that most
          window cleaning companies overlook. We work directly with each client to deliver the exact level of clean
          they want, treating every window as more than just glass. When desired, we go further — carefully removing
          paint, silicone, adhesive residue, and thoroughly cleaning tracks — restoring windows to a condition many
          homeowners haven’t seen in years.
        </p>
        <p class="mt-4 leading-relaxed text-slate-600">
          In addition to precision window cleaning, we offer professional gutter cleaning and pressure washing services
          that refresh exteriors and outdoor living spaces, helping homes look new again.
        </p>
        <p class="mt-4 font-display font-bold text-navy">Detail-focused. Client-driven. Actually clean.</p>
        <p class="mt-4 leading-relaxed text-slate-600">
          To make scheduling easier, customers in the West and Southwest suburbs can contact Eric at {site.phone}.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/#quote" class="btn-primary px-6 py-3 text-sm">Message Our Team</a>
          <a href={site.phoneHref} class="btn-outline-dark px-6 py-3 text-sm">Call {site.phone}</a>
        </div>
      </div>
      <div class="reveal">
        <MediaImage topic="team" image="/images/about.webp" label="Eric — owner & operator" class="aspect-[4/3]" />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-slate-200 bg-navy-faint" aria-label="Quick facts">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-10 sm:px-6 lg:grid-cols-4 lg:px-8">
      {[
        { value: `${site.rating.score}/5.0`, label: 'Google rating' },
        { value: site.rating.count, label: 'Happy customers' },
        { value: '5 yrs', label: 'Cleaning experience' },
        { value: '30 mi', label: 'Service radius' },
      ].map((stat) => (
        <div class="text-center">
          <p class="font-display text-3xl font-extrabold text-navy">{stat.value}</p>
          <p class="mt-1 text-sm text-slate-500">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Owner -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wider text-brand">The Owner</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-navy sm:text-4xl">Meet Eric</h2>
      </div>
      <div class="reveal mx-auto mt-12 grid max-w-4xl items-center gap-10 rounded-3xl border border-slate-200 bg-navy-faint p-8 shadow-soft sm:p-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <MediaImage topic="team" image="/images/about.webp" label="Eric — owner of Apollo Professional" class="aspect-square" />
        <div>
          <h3 class="font-display text-2xl font-bold text-navy">Eric — Owner & Operator</h3>
          <p class="mt-4 leading-relaxed text-slate-600">
            “I’m Eric, the owner of Apollo Professional, and I’m here to give you a satisfactory clean. With 5 years of
            experience, I’m confident you will be impressed with my skills and attention to detail. I enjoy window
            cleaning because it gives me time to be outdoors, and I enjoy giving people the pleasure of seeing nature
            again. When I’m not cleaning windows, I enjoy hiking, a good movie, or riding my bike.”
          </p>
          <p class="mt-4 leading-relaxed text-slate-600">
            If you value a seamless window cleaning experience, reach out and schedule a cleaning today.
          </p>
          <a href="/contact/#quote" class="btn-primary mt-6 px-6 py-3 text-sm">Request Your Cleaning Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-navy-faint py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-wider text-brand">What Sets Us Apart</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-navy sm:text-4xl">
          Delivering Thorough, Reliable Results Every Time
        </h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {values.map((value, i) => (
          <div class="reveal card-lift rounded-2xl border border-slate-200 bg-white p-7 shadow-soft" style={`transition-delay: ${(i % 2) * 60}ms`}>
            <h3 class="font-display text-lg font-bold text-navy">{value.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-wider text-brand">Who We Serve</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-navy sm:text-4xl">
          Residential & Select Commercial
        </h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((audience, i) => (
          <div class="reveal card-lift rounded-2xl border border-slate-200 bg-navy-faint p-6 shadow-soft" style={`transition-delay: ${(i % 4) * 60}ms`}>
            <h3 class="font-display text-lg font-bold text-navy">{audience.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{audience.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
