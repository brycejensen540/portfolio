---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { images } from '../data/images';
import CtaBand from '../components/CtaBand.astro';
import MediaImage from '../components/MediaImage.astro';

const title = 'About Us | Apollo Professional — Chicago, IL';
const description =
  'Meet Apollo Professional — a detail-focused cleaning team in Chicago, IL serving the surrounding suburbs. Window cleaning, gutters, screens, power washing, and more. Call (773) 600-1308.';

const values = [
  {
    title: 'Detail-Focused',
    text: 'Customers appreciate our thorough work — especially in window corners. Every job gets our full attention, with high-quality results that last.',
  },
  {
    title: 'We Always Show Up',
    text: 'Reliability is our reputation. We arrive as scheduled, communicate clearly, and walk through the finished job with you before we leave.',
  },
  {
    title: 'Local Expertise',
    text: 'Based in Chicago and serving a 30-mile radius around the city, we know the weather, the homes, and the buildup local properties face.',
  },
  {
    title: 'Respect for Your Property',
    text: 'We protect your floors and furniture during interior work, rinse exterior surfaces thoroughly, and leave no mess behind.',
  },
];

const audiences = [
  { name: 'Homeowners', text: 'Single-family homes, condos, and townhomes across the North Shore and western suburbs.' },
  { name: 'HOAs & Property Managers', text: 'Dependable, repeatable exterior maintenance for common areas and individual units.' },
  { name: 'Real Estate Agents', text: 'Sparkling windows and spotless exteriors that help listings show their best.' },
  { name: 'Select Commercial', text: 'Storefronts, offices, and low-rise buildings that project a professional image.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Apollo Professional',
  url: `${site.url}/about/`,
  about: {
    '@type': 'LocalBusiness',
    name: site.name,
    telephone: '+1-773-600-1308',
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  },
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-surface">
    <div
      class="pointer-events-none absolute -right-40 -top-40 h-[26rem] w-[26rem] rounded-full opacity-30 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(74, 143, 168, 0.2), transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-24 sm:px-6 lg:px-8 lg:pb-28 lg:pt-32">
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
        <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
        About Us
      </p>
      <h1 class="mt-6 max-w-3xl font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
        Detail-Focused Cleaning Services in Chicago, IL, and Beyond
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft">
        We don’t just clean windows so they look clean — we clean them so they <em class="font-display italic">are</em> clean. Apollo Professional
        prioritizes the quality, consistency, and meticulous attention to detail that most window cleaning companies
        overlook — treating every window as more than just glass.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-2 lg:gap-24 lg:px-8">
      <div class="reveal">
        <h2 class="font-display text-4xl font-semibold tracking-tight text-ink">Who We Are</h2>
        <p class="mt-6 leading-relaxed text-ink-soft">
          We don’t just clean windows so they look clean — we clean them so they <em class="font-display italic">are</em> clean.
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          Apollo Professional prioritizes the quality, consistency, and meticulous attention to detail that most
          window cleaning companies overlook. We work directly with each client to deliver the exact level of clean
          they want, treating every window as more than just glass. When desired, we go further — carefully removing
          paint, silicone, adhesive residue, and thoroughly cleaning tracks — restoring windows to a condition many
          homeowners haven’t seen in years.
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          In addition to precision window cleaning, we offer professional gutter cleaning and pressure washing services
          that refresh exteriors and outdoor living spaces, helping homes look new again.
        </p>
        <p class="mt-6 font-display text-xl font-medium italic text-ink">Detail-focused. Client-driven. Crystal-Clear.</p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          To make scheduling easier, customers in the West and Southwest suburbs can contact Eric at {site.phone}.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/#quote" class="btn-primary px-7 py-3.5 text-sm">Message Our Team</a>
          <a href={site.phoneHref} class="btn-outline px-7 py-3.5 text-sm">Call {site.phone}</a>
        </div>
      </div>
      <div class="reveal">
        <MediaImage image={images.about.home} label="A home in warm natural light" class="aspect-[4/5] shadow-lift" />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-ink/8 bg-surface-alt" aria-label="Quick facts">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 py-14 sm:px-6 lg:grid-cols-4 lg:px-8">
      {[
        { value: `${site.rating.score}/5.0`, label: 'Google rating' },
        { value: site.rating.count, label: 'Happy customers' },
        { value: '5 yrs', label: 'Cleaning experience' },
        { value: '30 mi', label: 'Service radius' },
      ].map((stat) => (
        <div class="text-center">
          <p class="font-display text-4xl font-semibold text-ink">{stat.value}</p>
          <p class="mt-2 text-sm text-ink-faint">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Owner -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="flex items-center justify-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
          The Owner
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Meet Eric</h2>
      </div>
      <div class="reveal mx-auto mt-14 grid max-w-4xl items-center gap-12 rounded-2xl bg-surface-alt p-10 ring-1 ring-ink/8 sm:p-14 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <MediaImage image={images.about.team} label="Eric — owner of Apollo Professional" class="aspect-square shadow-soft" />
        <div>
          <h3 class="font-display text-2xl font-semibold text-ink">Eric — Owner &amp; Operator</h3>
          <p class="mt-5 leading-relaxed text-ink-soft">
            “I’m Eric, the owner of Apollo Professional, and I’m here to give you a satisfactory clean. With 5 years of
            experience, I’m confident you will be impressed with my skills and attention to detail. I enjoy window
            cleaning because it gives me time to be outdoors, and I enjoy giving people the pleasure of seeing nature
            again. When I’m not cleaning windows, I enjoy hiking, a good movie, or riding my bike.”
          </p>
          <p class="mt-4 leading-relaxed text-ink-soft">
            If you value a seamless window cleaning experience, reach out and schedule a cleaning today.
          </p>
          <a href="/contact/#quote" class="btn-primary mt-8 px-7 py-3.5 text-sm">Request Your Cleaning Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-surface-alt py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal max-w-2xl">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
          What Sets Us Apart
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Delivering Thorough, Reliable Results Every Time
        </h2>
      </div>
      <div class="mt-14 grid gap-8 sm:grid-cols-2">
        {values.map((value, i) => (
          <div class="reveal card-lift rounded-2xl bg-white p-9 shadow-soft ring-1 ring-ink/5" style={`transition-delay: ${(i % 2) * 60}ms`}>
            <h3 class="font-display text-2xl font-semibold text-ink">{value.title}</h3>
            <p class="mt-4 leading-relaxed text-ink-soft">{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal max-w-2xl">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-accent/50" aria-hidden="true"></span>
          Who We Serve
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Residential &amp; Select Commercial
        </h2>
      </div>
      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((audience, i) => (
          <div class="reveal card-lift rounded-2xl bg-surface-alt p-8 ring-1 ring-ink/8" style={`transition-delay: ${(i % 4) * 60}ms`}>
            <h3 class="font-display text-xl font-semibold text-ink">{audience.name}</h3>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">{audience.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
