---
import { site } from '../data/site';
import { services } from '../data/services';
import { areaPages } from '../data/areas';
import Bubbles from './Bubbles.astro';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink text-white">
  <Bubbles />
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2 lg:grid-cols-3 lg:px-8">
    <!-- Brand -->
    <div>
      <a href="/" class="flex items-center" aria-label="Apollo Professional — home">
        <img src="/images/logo-white.png" alt="Apollo Professional" class="h-10 w-auto" />
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/55">{site.tagline}</p>
      <div class="mt-5 flex items-center gap-2 text-sm text-white/65">
        <span class="flex text-accent" aria-hidden="true">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
        </span>
        <span><strong class="text-white">{site.rating.score}</strong> · {site.rating.label}</span>
      </div>
    </div>

    <!-- Services -->
    <nav aria-label="Services">
      <h2 class="text-xs font-bold uppercase tracking-widest text-white/35">Services</h2>
      <ul class="mt-5 space-y-3">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}/`} class="text-sm text-white/60 transition-colors hover:text-accent">{s.name}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Service areas -->
    <nav aria-label="Service areas">
      <h2 class="text-xs font-bold uppercase tracking-widest text-white/35">Service Areas</h2>
      <ul class="mt-5 space-y-3">
        <li><a href="/areas/" class="text-sm text-white/60 transition-colors hover:text-accent">All Service Areas</a></li>
        {areaPages.map((a) => (
          <li><a href={`/areas/${a.slug}/`} class="text-sm text-white/60 transition-colors hover:text-accent">{a.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-8 text-center text-xs text-white/40 sm:px-6 md:flex-row md:text-left lg:px-8">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex flex-col items-center gap-1.5 md:flex-row md:gap-6">
        <a href={site.phoneHref} class="transition-colors hover:text-accent">{site.phone}</a>
        <a href={site.emailHref} class="transition-colors hover:text-accent">{site.email}</a>
        <span>{site.hours.weekdays} · {site.hours.weekends}</span>
      </div>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>
