---
import { site } from '../data/site';
import { services } from '../data/services';
import { areaPages } from '../data/areas';

const year = new Date().getFullYear();
---

<footer class="bg-navy-deep text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
    <!-- Brand -->
    <div class="sm:col-span-2 lg:col-span-1">
      <a href="/" class="flex items-center gap-2.5" aria-label="Apollo Professional — home">
        <svg class="h-9 w-9" viewBox="0 0 40 40" aria-hidden="true">
          <rect width="40" height="40" rx="10" fill="#12305F" />
          <rect x="11" y="11" width="18" height="18" rx="2" fill="none" stroke="#fff" stroke-width="2.5" />
          <path d="M20 11v18M11 20h18" stroke="#fff" stroke-width="2.5" />
          <path d="M27 13.5l1.8 1.8M31.5 18.5l2-0.8" stroke="#38BDF8" stroke-width="2.2" stroke-linecap="round" />
        </svg>
        <span class="font-display text-lg font-extrabold tracking-tight">Apollo Professional</span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-white/65">{site.tagline}</p>
      <div class="mt-4 flex items-center gap-2 text-sm text-white/80">
        <span class="flex text-sky-bright" aria-hidden="true">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" /></svg>
        </span>
        <span><strong class="text-white">{site.rating.score}</strong> · {site.rating.label}</span>
      </div>
    </div>

    <!-- Services -->
    <nav aria-label="Services">
      <h2 class="font-display text-sm font-bold uppercase tracking-wider text-white/45">Services</h2>
      <ul class="mt-4 space-y-2.5">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}/`} class="text-sm text-white/70 transition-colors hover:text-sky-bright">{s.name}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Service areas -->
    <nav aria-label="Service areas">
      <h2 class="font-display text-sm font-bold uppercase tracking-wider text-white/45">Service Areas</h2>
      <ul class="mt-4 space-y-2.5">
        <li><a href="/areas/" class="text-sm text-white/70 transition-colors hover:text-sky-bright">All Service Areas</a></li>
        {areaPages.map((a) => (
          <li><a href={`/areas/${a.slug}/`} class="text-sm text-white/70 transition-colors hover:text-sky-bright">{a.name}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Contact -->
    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-wider text-white/45">Contact</h2>
      <ul class="mt-4 space-y-3 text-sm text-white/70">
        <li>
          <a href={site.phoneHref} class="font-semibold text-white transition-colors hover:text-sky-bright">{site.phone}</a>
        </li>
        <li>
          <a href={site.emailHref} class="transition-colors hover:text-sky-bright">{site.email}</a>
        </li>
        <li>{site.address} · serving {site.radius}</li>
        <li class="pt-1 text-white/50">
          {site.hours.weekdays}<br />{site.hours.weekends}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-white/45 sm:flex-row sm:px-6 lg:px-8">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Detail-focused. Reliable. Always show up.</p>
    </div>
  </div>
</footer>
