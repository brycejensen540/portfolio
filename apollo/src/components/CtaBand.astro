---
import { site } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Get Started With Professional Cleaning',
  subtitle = 'Reach out now for professional cleaning solutions with unmatched detail and reliability. We’re ready to help you.',
} = Astro.props;
---

<section class="bg-gradient-to-br from-navy-deep via-navy to-navy-mid py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col items-center gap-6 text-center">
      <h2 class="max-w-2xl font-display text-3xl font-bold text-white sm:text-4xl">{title}</h2>
      <p class="max-w-xl text-base leading-relaxed text-white/75">{subtitle}</p>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <a href={site.phoneHref} class="btn-outline-light px-7 py-3 text-base">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3.5 4.5c0-1.1.9-2 2-2h2l1.5 4-2 1.5a11 11 0 005 5l1.5-2 4 1.5v2c0 1.1-.9 2-2 2A12.5 12.5 0 013.5 4.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
          Call {site.phone}
        </a>
        <a href="/contact/#quote" class="btn-primary px-7 py-3 text-base">Get a Free Quote</a>
      </div>
      <p class="text-xs text-white/50">
        {site.hours.weekdays} · {site.hours.weekends} · {site.address}
      </p>
    </div>
  </div>
</section>
