---
import MediaImage from './MediaImage.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}/`}
  class="card-lift shine group flex flex-col rounded-2xl bg-white shadow-soft ring-1 ring-ink/5"
>
  <MediaImage image={service.image} label={service.name} class="aspect-[16/10]" />
  <div class="flex flex-1 flex-col p-8">
    <h3 class="font-display text-2xl font-semibold tracking-tight text-ink">{service.name}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{service.shortDescription}</p>
    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors group-hover:text-accent-dark">
      Learn more
      <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 10h12m0 0l-4-4m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
