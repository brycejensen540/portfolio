---
interface Props {
  label?: string;
  class?: string;
  image?: string;
}

const { label = 'Apollo Professional', class: className = '', image } = Astro.props;
---

<div class={`relative overflow-hidden rounded-2xl bg-surface-alt ${className}`}>
  {image ? (
    <img src={image} alt={label} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
  ) : (
    <div class="flex h-full w-full items-center justify-center p-8" role="img" aria-label={label}>
      <span class="text-center text-xs font-semibold uppercase tracking-widest text-ink-faint">{label}</span>
    </div>
  )}
</div>
